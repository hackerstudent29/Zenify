{
  "rules": [
    {
      "allowed": {
        "origins": ["*"],
        "methods": ["GET", "HEAD"],
        "headers": ["Range", "Content-Type", "Accept", "Origin"]
      },
      "exposeHeaders": ["Content-Range", "Accept-Ranges", "Content-Length", "Content-Type"],
      "maxAgeSeconds": 3000
    }
  ]
}
