# ==============================================================================
# Zenify Backend Environment Configuration Example
# Copy this file to .env and adjust values for local development
# ==============================================================================

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zenify?schema=public

# Authentication (Generate secure 32+ character strings)
JWT_SECRET=change_this_to_a_secure_jwt_secret_min_32_chars
REFRESH_TOKEN_SECRET=change_this_to_a_secure_refresh_secret_min_32_chars
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Email Verification (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Cloudflare R2 Storage (Optional - falls back to local storage)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# Cloudinary (Optional - for image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Synced Lyrics (Optional - Deepgram Nova)
DEEPGRAM_API_KEY=

# Optional Redis Cache
REDIS_URL=
