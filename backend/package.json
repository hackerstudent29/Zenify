{
  "name": "backend",
  "version": "1.0.9",
  "description": "Zenify Backend API — Fastify 5, TypeScript, Prisma, Redis, 320kbps audio resolver, multilingual lyrics orchestrator, and real-time Room Together WebSocket engine.",
  "homepage": "https://listenzenify.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/hackerstudent29/Zenify.git",
    "directory": "backend"
  },
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "check:r2": "node scripts/check-cloudflare-storage.js",
    "check:cloudinary": "node scripts/check-cloudinary-storage.js",
    "check:db": "node scripts/check-heroku-db-storage.js",
    "check:all": "node scripts/check-cloudflare-storage.js && node scripts/check-cloudinary-storage.js && node scripts/check-heroku-db-storage.js",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "music-streaming",
    "music-streaming-app",
    "music-app",
    "music-player",
    "online-music-player",
    "free-music",
    "spotify-alternative",
    "ad-free",
    "no-ads",
    "open-source",
    "audio-streaming",
    "synced-lyrics",
    "lyrics",
    "apple-music-ui",
    "playlist",
    "equalizer",
    "android",
    "karaoke",
    "local-music-player",
    "mp3-player"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
