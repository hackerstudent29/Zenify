    "@fastify/websocket": "^11.3.6",
    "@prisma/client": "5.10.2",
    "@supabase/supabase-js": "^2.97.0",
    "ai": "^6.0.203",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.77.1",
    "cheerio": "^1.2.0",
    "chroma-js": "^3.2.0",
