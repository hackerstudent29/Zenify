  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_achievements")
}

// ============================================================================
// ROOM TOGETHER (Phase 1 + Phase 2)
// ============================================================================

model TogetherRoom {
  code                   String    @id @db.VarChar(12)
  hostId                 String    @map("host_id") @db.VarChar(64)
  name                   String    @default("Listening Room") @db.VarChar(100)
  description            String    @default("")
  coverUrl               String?   @map("cover_url")
  mode                   String    @default("collab") @db.VarChar(16)
  isPrivate              Boolean   @default(false) @map("is_private")
  passwordHash           String?   @map("password_hash")
  maxMembers             Int       @default(25) @map("max_members")
  durationMinutes        Int       @default(240) @map("duration_minutes")
  expiresAt              DateTime? @map("expires_at")
  inviteMode             String    @default("ANYONE") @map("invite_mode") @db.VarChar(16)
  speakPolicy            String    @default("ALL") @map("speak_policy") @db.VarChar(24)
  allowListenersAddQueue Boolean   @default(true) @map("allow_listeners_add_queue")
  allowListenersSkip     Boolean   @default(false) @map("allow_listeners_skip")
  state                  String    @default("ACTIVE") @db.VarChar(16)
  currentTrackId         String?   @map("current_track_id") @db.VarChar(128)
  currentTrack           Json?     @map("current_track")
  queue                  Json      @default("[]")
  queueRevision          Int       @default(1) @map("queue_revision")
  playbackState          String    @default("paused") @map("playback_state") @db.VarChar(16)
  playbackPositionMs     BigInt    @default(0) @map("playback_position_ms")
  startedAtServerMs      BigInt?   @map("started_at_server_ms")
  seq                    BigInt    @default(1)
  livekitRoomName        String?   @map("livekit_room_name") @db.VarChar(128)
  endedReason            String?   @map("ended_reason") @db.VarChar(32)
  endedAt                DateTime? @map("ended_at")
  themePreset            String    @default("MIDNIGHT") @map("theme_preset") @db.VarChar(32)
  themeAccentHex         String?   @map("theme_accent_hex") @db.VarChar(16)
  themeBgUrl             String?   @map("theme_bg_url")
  requestMode            String    @default("ANYONE") @map("request_mode") @db.VarChar(16)
  requestMaxPerUser      Int       @default(3) @map("request_max_per_user")
  queueLocked            Boolean   @default(false) @map("queue_locked")
  announceText           String?   @map("announce_text") @db.VarChar(240)
  announceUntilMs        BigInt?   @map("announce_until_ms")
  playbackRate           Float     @default(1.0) @map("playback_rate")
  totalDurationPlayedMs  BigInt    @default(0) @map("total_duration_played_ms")
  skipVotes              Json      @default("[]") @map("skip_votes")
  reactionCounts         Json      @default("{}") @map("reaction_counts")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@index([state])
  @@index([expiresAt])
  @@index([hostId])
  @@map("rooms")
}

model TogetherRoomMember {
