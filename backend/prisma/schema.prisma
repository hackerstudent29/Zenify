  lastPlayed  DateTime  @default(now()) @map("last_played")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, artistKey])
  @@index([userId, plays(sort: Desc)])
  @@index([userId, listenedMs(sort: Desc)])
