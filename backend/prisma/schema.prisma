generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String           @id @default(uuid())
  email         String           @unique
  name          String?
  password      String?
  role          Role             @default(LISTENER)
  provider      String           @default("LOCAL")
  googleId      String?          @unique
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  age           Int?
  avatarUrl     String?
  country       String?
  username      String?          @unique
  isVerified    Boolean          @default(false)
  timezone      String?          @default("UTC")
  isGuest       Boolean          @default(false) @map("is_guest")
  deletedAt     DateTime?        @map("deleted_at")
  displayName   String?          @map("display_name")
  bio           String?
  history       History[]
  likes         Like[]
  playlists     Playlist[]
  purchases     Purchase[]
  ratings       Rating[]
  refreshTokens RefreshToken[]
  subscription  Subscription?
  tracks        Track[]
  transactions  Transaction[]
  preferences     UserPreferences?
  stats           UserTrackStat[]
  dailyStats      UserDailyStat[]
  notifications   Notification[]
  analysisSlot    Int?             @unique
  activityEvents  UserActivityEvent[]
  interestProfile UserInterestProfile?
  listenEvents    ListenEvent[]
  analysisRuns    AnalysisRun[]
  affinities      UserAffinity[]
  followedArtists ArtistFollow[]
  pushSubscriptions PushSubscription[]
  notificationPreference NotificationPreference?
  replays         ReplaySnapshot[]
  blendSessionsA  BlendSession[] @relation("BlendUserA")
  blendSessionsB  BlendSession[] @relation("BlendUserB")
  identities      AuthIdentity[]
  activeSessions  Session[]
  listeningEvents ListeningEvent[]
  listeningEventArtists ListeningEventArtist[]
  userArtistStats UserArtistStat[]
  userHourlyStats UserHourlyStat[]
  userAchievements UserAchievement[]
  savedAlbums     SavedAlbum[]
}

model Subscription {
  id          String    @id @default(uuid())
  userId      String    @unique
  status      String
  plan        String    @default("PREMIUM")
  referenceId String?   @unique
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Int
  status      String
  referenceId String   @unique
  type        String
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model Purchase {
  id          String   @id @default(uuid())
  userId      String
  trackId     String
  price       Int      @default(0)
  status      String   @default("COMPLETED")
  referenceId String   @unique
  createdAt   DateTime @default(now())
  track       Track    @relation(fields: [trackId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

model UserPreferences {
  id                  String   @id @default(uuid())
  userId              String   @unique
  onboardingCompleted   Boolean   @default(false)
  onboardingCompletedAt DateTime?
  preferredGenres       String[]  @default([])
  languages             String[]  @default([])
  favoriteArtists       Json?
  favoriteAlbums        Json?
  audioQuality          String    @default("high")
  crossfade           Boolean  @default(false)
  autoplay            Boolean  @default(true)
  normalizeVolume     Boolean  @default(true)
  explicitFilter      Boolean  @default(false)
  theme               String   @default("dark")
  accentColor         String   @default("green")
  globalPlayerStyle   String   @default("glassmorphism")
  sidebarStyle        String   @default("normal")
  fullviewReactiveBg  Boolean  @default(true)
  trackPageReactiveBg Boolean  @default(true)
  compactMode         Boolean  @default(false)
  emailNotifications  Boolean  @default(false)
  newReleaseAlerts    Boolean  @default(false)
  playlistUpdates     Boolean  @default(false)
  weeklySummaryEmail  Boolean  @default(false)
  privateSession      Boolean  @default(false)
  listeningActivity   Boolean  @default(true)
  surroundingSpeed    Int      @default(3)
  bottomNavStyle      String   @default("normal")
  swipeNavigation     Boolean  @default(true)
  selectedCountryCode  String?  @map("selected_country_code")
  selectedCountryName  String?  @map("selected_country_name")
  selectedLanguageCode String?  @map("selected_language_code")
  selectedLanguageName String?  @map("selected_language_name")
  personalizationEnabled Boolean @default(true) @map("personalization_enabled")
  cellularQuality     String   @default("high") @map("cellular_quality")
  downloadQuality     String   @default("lossless") @map("download_quality")
  gaplessPlayback     Boolean  @default(true) @map("gapless_playback")
  lyricsDefaultScript String   @default("original") @map("lyrics_default_script")
  saveListeningHistory Boolean @default(true) @map("save_listening_history")
  profileVisibility   String   @default("public") @map("profile_visibility")
  showTopArtists      Boolean  @default(true) @map("show_top_artists")
  defaultRoomMode     String   @default("dj") @map("default_room_mode")
  whoCanInvite        String   @default("everyone") @map("who_can_invite")
  autoHideDetails     Boolean  @default(true) @map("auto_hide_details")
  syncTimestamps      Json?    @map("sync_timestamps")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSettings {
  id        String   @id @default("global")
  keys      Json     @default("{}") // Stores API keys and global config
  updatedAt DateTime @updatedAt
}

model Artist {
  id               String                   @id @default(uuid())
  name             String                   @unique
  bio              String?
  imageUrl         String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  follower_count   Int?                     @default(0)
  popularity_score Float?                   @default(0)
  verified         Boolean?                 @default(false)
  birthDate        DateTime?
  coverUrl         String?
  monthlyListeners Int?                     @default(0)
  role             String?
  search_vector    Unsupported("tsvector")?
  totalStreams     BigInt?                  @default(0)
  aura_color       String?
  aura_vibe        String?
  albums           Album[]
  tracks           Track[]
  providerId       String?                  @map("provider_id")
  provider         String                   @default("jiosaavn")
  aliases          ArtistAlias[]
  trackArtists     TrackArtist[]

  @@index([name])
  @@index([providerId])
  @@index([provider, providerId])
}

model Album {
  id               String                   @id @default(uuid())
  title            String
  coverUrl         String?
  artistId         String
  releaseDate      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  popularity_score Float?                   @default(0)
  search_vector    Unsupported("tsvector")?
  aura_color       String?
  aura_vibe        String?
  palette          Json?   // Stores [{r,g,b},{r,g,b},{r,g,b},{r,g,b}] extracted from coverUrl
  providerId       String?                  @map("provider_id")
  provider         String                   @default("jiosaavn")
  artist           Artist                   @relation(fields: [artistId], references: [id])
  tracks           Track[]

  @@index([title])
  @@index([providerId])
  @@index([provider, providerId])
}

model Track {
  id               String                   @id @default(uuid())
  title            String
  providerId       String?                  @map("provider_id")
  provider         String                   @default("jiosaavn")
  artistId         String
  albumId          String?
  coverUrl         String?
  audioUrl         String
  duration         Int
  genre            String?
  lyrics           String?
  lyricsOffset     Int                      @default(0)
  description      String?
  tags             String[]
  isFeatured       Boolean                  @default(false)
  isTrending       Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  releaseDate      DateTime?
  deletedAt        DateTime?
  price            Int                      @default(0)
  allowDownloads   Boolean                  @default(true)
  bpm              Int?
  composers        String?
  copyrightLabel   String?
  downloads        Int                      @default(0)
  enableComments   Boolean                  @default(true)
  featuredArtists  String?
  isUnlisted       Boolean                  @default(false)
  key              String?
  language         String?                  @default("english")
  like_count       Int?                     @default(0)
  popularity_score Float?                   @default(0)
  producers        String?
  releaseStatus    String                   @default("PUBLISHED")
  scheduledAt      DateTime?
  userId           String?
  engagement_score Float?                   @default(0)
  region           String?                  @default("Global")
  search_vector    Unsupported("tsvector")?
  streams          Int                      @default(0)
  trackNumber      Int?                     @default(1)
  track_type       String                   @default("original")
  aura_color       String?
  aura_vibe        String?
  lyrics_meaning   String?
  synced_lyrics    Json?
  lyric_versions   Json?
  raw_lrc          String?
  sync_source        String?
  romanizedLyrics       String?
  romanizedSyncedLyrics Json?
  romanizedLang         String?
  romanizedAt           DateTime?
  sourceHash            String?
  analysisData       Json?
  palette            Json?   // Stores [{r,g,b},{r,g,b},{r,g,b},{r,g,b}] extracted from coverUrl
  normalizedTitle    String?
  primaryArtists     String?
  metadataSource     String?  @default("embedded")
  metadataConfidence Float?   @default(1.0)
  metadataVerifiedAt DateTime?
  countryCode        String?  @map("country_code")
  countryName        String?  @map("country_name")
  languageCode       String?  @map("language_code")
  languageName       String?  @map("language_name")
  languages          String[] @default([])
  metadataStatus     String?  @default("pending") @map("metadata_status")
  metadataUpdatedAt  DateTime? @map("metadata_updated_at")
  trendingScore      Float?   @default(0)
  youtubeId            String?
  audioResolutionScore Float?
  isrc                 String?
  otherVersions        Json?
  history            History[]
  likes              Like[]
  playlistTracks     PlaylistTrack[]
  purchases          Purchase[]
  ratings            Rating[]
  album              Album?                   @relation(fields: [albumId], references: [id])
  artist             Artist                   @relation(fields: [artistId], references: [id])
  user               User?                    @relation(fields: [userId], references: [id])
  analytics          TrackAnalytics[]
  userStats          UserTrackStat[]
  vibeProfile        TrackVibeProfile?
  lyricJob           LyricEnrichmentJob?
  trackArtists       TrackArtist[]
  listenEvents       ListenEvent[]

  @@index([title])
  @@index([providerId])
  @@index([provider, providerId])
  @@index([artistId])
  @@index([albumId])
  @@index([deletedAt])
  @@index([genre])
  @@index([streams])
  @@index([createdAt])
  @@index([engagement_score])
  @@index([language])
  @@index([region])
  @@index([countryCode, languageCode])
  @@index([countryCode])
  @@index([languageCode])
  @@index([metadataStatus])
  @@index([track_type])
  @@index([trendingScore])
}

model TrackAnalytics {
  id                String   @id @default(uuid())
  trackId           String
  date              DateTime @default(now())
  total_listen_time Int      @default(0)
  stream_count      Int      @default(0)
  track             Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, date])
  @@index([date])
}

model Playlist {
  id               String                   @id @default(uuid())
  name             String
  description      String?
  coverUrl         String?
  userId           String
  isPublic         Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  follower_count   Int?                     @default(0)
  popularity_score Float?                   @default(0)
  search_vector    Unsupported("tsvector")?
  user             User                     @relation(fields: [userId], references: [id])
  tracks           PlaylistTrack[]

  @@index([name])
  @@index([userId])
}

model PlaylistTrack {
  id         String   @id @default(uuid())
  playlistId String
  trackId    String
  addedAt    DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  trackId   String
  createdAt DateTime @default(now())
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

model SavedAlbum {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  artist    String
  coverUrl  String?  @map("cover_url")
  browseId  String?  @map("browse_id")
  year      Int?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, title, artist])
  @@index([userId])
  @@map("saved_albums")
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  trackId   String
  value     Int
  createdAt DateTime @default(now())
  comment   String?
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

model UserTrackStat {
  id                  String   @id @default(uuid())
  userId              String
  trackId             String
  completionRateAvg   Float?   @default(0)
  skipCount           Int      @default(0)
  totalListenDuration Int      @default(0)
  resumeProgress      Float?   @default(0)
  lastStreamedAt      DateTime @default(now())
  streamCount         Int      @default(0)
  track               Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model History {
  id       String   @id @default(uuid())
  userId   String
  trackId  String
  playedAt DateTime @default(now())
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([trackId])
  @@index([playedAt])
}

model UserDailyStat {
  id              String   @id @default(uuid())
  userId          String
  date            DateTime @default(now())
  minutesListened Int      @default(0)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

enum Role {
  ADMIN
  LISTENER
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // e.g., 'upload_success', 'upload_failed', 'content_denied', 'system_info'
  title     String
  message   String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model FeaturedContent {
  id          String    @id @default(uuid())
  contentType String    @default("track") // 'track', 'album', 'artist', 'playlist'
  contentId   String
  title       String?
  description String?
  priority    Int       @default(0)
  startAt     DateTime?
  endAt       DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([contentType, contentId])
  @@index([isActive, priority])
}

model UserActivityEvent {
  id        String   @id @default(uuid())
  userId    String
  eventType String   // 'play', 'like', 'save_album', 'playlist_create', 'download', 'search', 'search_click', 'skip', 'completion', 'replay', 'onboarding'
  eventData Json     // context, trackId, artistId, genre, language, query, resultId, position, sourceType
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([eventType])
}

model UserInterestProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  languageWeights Json     // { [lang: string]: number }
  genreWeights    Json     // { [genre: string]: number }
  artistWeights   Json     // { [artist: string]: number }
  interests       Json     // string[]
  moods           Json     // string[]
  seeds           Json     // string[]
  analyzedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TrackVibeProfile {
  id          String   @id @default(uuid())
  trackId     String   @unique
  moodTags    String[] @default([])
  energy      Float    @default(0.5)
  tempoBucket String   @default("mid") // 'slow' | 'mid' | 'fast'
  genre       String?
  language    String?
  era         String?
  vibeScore   Float?   @default(0.5)
  features    Json?    // Audio/acoustic features & mood vector
  analyzedAt  DateTime @default(now())
  track       Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([genre, language])
}

model AnalysisRun {
  id         String   @id @default(uuid())
  userId     String
  runDate    String   // 'YYYY-MM-DD' in Asia/Kolkata
  status     String   // 'SUCCESS' | 'FAILED' | 'SKIPPED'
  durationMs Int      @default(0)
  error      String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, runDate])
  @@index([createdAt])
  @@index([userId])
}

model LyricEnrichmentJob {
  id              String    @id @default(uuid())
  trackId         String    @unique
  status          String    @default("pending") // 'pending' | 'searching_lyrics' | 'transcribing' | 'aligning' | 'synced' | 'no_lyrics_detected' | 'retry_wait' | 'needs_review' | 'failed'
  audioHash       String?
  attempts        Int       @default(0)
  maxAttempts     Int       @default(3)
  lastProcessedAt DateTime?
  nextRetryAt     DateTime?
  source          String?   // 'lrclib' | 'musixmatch' | 'genius' | 'deepgram_stt' | 'deepgram_alignment'
  enrichmentType  String?   // 'sourced_synced' | 'aligned_plain' | 'transcribed_stt' | 'instrumental' | 'no_vocals'
  confidence      Float?
  error           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  track           Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([trackId])
}

model ArtistAlias {
  id              String   @id @default(uuid())
  aliasNormalized String   @unique @map("alias_normalized")
  artistId        String?  @map("artist_id")
  source          String   // 'manual' | 'strip_title' | 'catalog' | 'llm'
  confidence      Float
  status          String   @default("ok") // 'ok' | 'needs_review'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  artist          Artist?  @relation(fields: [artistId], references: [id], onDelete: SetNull)

  @@map("artist_aliases")
  @@index([aliasNormalized])
  @@index([artistId])
}


model TrackArtist {
  id        String   @id @default(uuid())
  trackId   String   @map("track_id")
  artistId  String   @map("artist_id")
  role      String   @default("primary") // 'primary' | 'featured' | 'music' | 'lyricist' | 'singer' | 'starring'
  order     Int      @default(0)
  createdAt DateTime @default(now())

  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([trackId, artistId, role])
  @@index([trackId])
  @@index([artistId])
  @@index([role])
  @@map("track_artists")
}

model ProviderCache {
  key       String   @id
  provider  String   @default("jiosaavn")
  data      Json
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("provider_cache")
}

model ListenEvent {
  id             String   @id @default(uuid())
  clientEventId  String?  @unique @map("client_event_id")
  userId         String   @map("user_id")
  trackId        String   @map("track_id")
  artistIds      String[] @map("artist_ids")
  albumId        String?  @map("album_id")
  language       String?
  msPlayed       Int      @map("ms_played")
  durationMs     Int      @map("duration_ms")
  completed      Boolean  @default(false)
  skipped        Boolean  @default(false)
  source         String?  @default("player")
  hour           Int?     // 0-23 in user local time
  createdAt      DateTime @default(now()) @map("created_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track          Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, trackId])
  @@index([userId])
  @@index([trackId])
  @@index([createdAt])
  @@map("listen_events")
}

model UserAffinity {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  kind      String   // 'artist' | 'language' | 'album' | 'genre'
  key       String   // e.g. provider artistId or language code
  score     Float    @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, key])
  @@index([userId, kind, score])
  @@map("user_affinities")
}

model ArtistFollow {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  artistProviderId String   @map("artist_provider_id")
  artistKey        String?  @map("artist_key")
  browseId         String?  @map("browse_id")
  artistName       String   @map("artist_name")
  artistImage      String?  @map("artist_image")
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, artistProviderId])
  @@index([userId])
  @@index([artistProviderId])
  @@index([userId, artistKey])
  @@map("artist_follows")
}

model ArtistRelease {
  id               String    @id @default(uuid())
  artistProviderId String    @map("artist_provider_id")
  albumProviderId  String    @map("album_provider_id")
  title            String
  coverUrl         String?
  releaseDate      DateTime?
  firstSeenAt      DateTime  @default(now())

  @@unique([artistProviderId, albumProviderId])
  @@index([artistProviderId])
  @@map("artist_releases")
}

model PushSubscription {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model NotificationPreference {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  newReleases  Boolean  @default(true)
  dailyDigest  Boolean  @default(false)
  mutedArtists String[] @default([])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model ReplaySnapshot {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  year        Int
  data        Json
  generatedAt DateTime @default(now()) @map("generated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@index([userId])
  @@map("replay_snapshots")
}

model BlendSession {
  id              String         @id @default(uuid())
  userAId         String         @map("user_a_id")
  userBId         String?        @map("user_b_id")
  inviteTokenHash String         @unique @map("invite_token_hash")
  status          String         @default("PENDING") // PENDING | ACTIVE | ARCHIVED
  expiresAt       DateTime       @map("expires_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  userA           User           @relation("BlendUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB           User?          @relation("BlendUserB", fields: [userBId], references: [id], onDelete: Cascade)
  snapshot        BlendSnapshot?

  @@index([userAId])
  @@index([userBId])
  @@index([status])
  @@map("blend_sessions")
}

model BlendSnapshot {
  id            String       @id @default(uuid())
  sessionId     String       @unique @map("session_id")
  tracks        Json
  matchScore    Float        @default(0) @map("match_score")
  sharedArtists Json?        @map("shared_artists")
  generatedAt   DateTime     @default(now()) @map("generated_at")

  session       BlendSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("blend_snapshots")
}


// ==========================================
// MULTI-PROVIDER LYRICS PIPELINE (PHASE 5)
// ==========================================

model Lyrics {
  id          String    @id @default(uuid())
  trackId     String    @unique @map("track_id")
  syncLevel   String    @map("sync_level")
  provider    String
  providerRef String?   @map("provider_ref")
  language    String?
  script      String?
  instrumental Boolean  @default(false)
  aiGenerated Boolean   @default(false) @map("ai_generated")
  aiSynced    Boolean   @default(false) @map("ai_synced")
  contentJson Json      @map("content_json")
  fetchedAt   DateTime  @default(now()) @map("fetched_at")
  recheckAt   DateTime? @map("recheck_at")
  expiresAt   DateTime? @map("expires_at")

  @@index([trackId])
  @@index([syncLevel])
  @@index([provider])
  @@index([expiresAt])
  @@map("lyrics_documents")
}

model LyricsAttempt {
  id        String   @id @default(uuid())
  trackId   String   @map("track_id")
  provider  String
  outcome   String
  ms        Int
  createdAt DateTime @default(now()) @map("created_at")

  @@index([trackId])
  @@index([provider])
  @@index([createdAt])
  @@map("lyrics_attempts")
}

// ==========================================
// AUTH & MULTI-IDENTITY (PHASE 11)
// ==========================================

model AuthIdentity {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  provider       String   // 'google' | 'email'
  providerUserId String   @map("provider_user_id")
  email          String?
  createdAt      DateTime @default(now()) @map("created_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@index([email])
  @@map("auth_identities")
}

model OtpCode {
  id            String    @id @default(uuid())
  email         String
  codeHash      String    @map("code_hash")
  expiresAt     DateTime  @map("expires_at")
  attempts      Int       @default(0)
  consumedAt    DateTime? @map("consumed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  requestIpHash String?   @map("request_ip_hash")

  @@index([email, createdAt(sort: Desc)])
  @@map("otp_codes")
}

model Session {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  refreshHash String    @unique @map("refresh_hash")
  familyId    String    @map("family_id")
  deviceId    String?   @map("device_id")
  deviceName  String?   @map("device_name")
  platform    String?   @map("platform")
  appVersion  String?   @map("app_version")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastUsedAt  DateTime  @default(now()) @map("last_used_at")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

// ==========================================
// LISTENING TRACKING & INSIGHTS (PHASE 13)
// ==========================================

model ListeningEvent {
  userId          String   @map("user_id")
  eventId         String   @map("event_id")
  startedAt       DateTime @map("started_at")
  endedAt         DateTime @map("ended_at")
  tzOffsetMin     Int      @map("tz_offset_min")
  listenedMs      Int      @map("listened_ms")
  trackDurationMs Int      @map("track_duration_ms")
  endReason       String   @map("end_reason")
  trackSource     String   @default("youtube") @map("track_source")
  trackId         String   @map("track_id")
  trackTitle      String   @map("track_title")
  trackAlbum      String?  @map("track_album")
  language        String?  @map("language")
  genre           String?  @map("genre")
  contextType     String?  @map("context_type")
  contextId       String?  @map("context_id")
  offline         Boolean  @default(false)
  quality         Int      @default(256)
  deviceId        String?  @map("device_id")
  qualified       Boolean  @default(false)
  isSkip          Boolean  @default(false) @map("is_skip")
  isRepeat        Boolean  @default(false) @map("is_repeat")
  completed       Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, trackId])
  @@map("listening_events")
}

model ListeningEventArtist {
