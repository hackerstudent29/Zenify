generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  LISTENER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  username  String?  @unique
  avatarUrl String?
  password  String?
  role      Role     @default(LISTENER)
  isVerified Boolean  @default(false)
  provider  String   @default("LOCAL")
  googleId  String?  @unique
  country   String?
  age       Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes         Like[]
  playlists     Playlist[]
  stats         UserTrackStat[]
  history       History[]
  ratings       Rating[]
  refreshTokens RefreshToken[]
  preferences   UserPreferences?
  subscription  Subscription?
  transactions  Transaction[]
  purchases     Purchase[]
  tracks        Track[]
}

model Subscription {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String   // ACTIVE, CANCELLED, EXPIRED
  plan         String   @default("PREMIUM")
  referenceId  String?  @unique // ZenWallet reference
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Int      // in cents
  status      String   // PENDING, COMPLETED, FAILED
  referenceId String   @unique // ZenWallet reference
  type        String   // SUBSCRIPTION, TRACK_PURCHASE
  metadata    Json?    // stores trackId if purchase
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Purchase {
  id        String   @id @default(uuid())
  userId    String
  trackId   String
  price     Int      @default(0)
  status    String   @default("COMPLETED")
  referenceId String @unique
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id])

  @@unique([userId, trackId])
}

model UserPreferences {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Onboarding
  onboardingCompleted Boolean  @default(false)
  preferredGenres     String[] @default([])

  // Playback
  audioQuality    String  @default("high") // low, high, lossless
  crossfade       Boolean @default(false)
  autoplay        Boolean @default(true)
  normalizeVolume Boolean @default(true)
  explicitFilter  Boolean @default(false)

  // Appearance
  theme       String  @default("dark")
  accentColor String  @default("green") // green, violet
  compactMode Boolean @default(false)

  // Notifications
  emailNotifications Boolean @default(true)
  newReleaseAlerts   Boolean @default(true)
  playlistUpdates    Boolean @default(true)

  // Privacy
  privateSession    Boolean @default(false)
  listeningActivity Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Artist {
  id        String   @id @default(uuid())
  name      String   @unique
  bio       String?
  role      String?
  birthDate DateTime?
  imageUrl  String?
  coverUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Search & Ranking Metadata
  follower_count   Int?     @default(0)
  verified         Boolean? @default(false)
  popularity_score Float?   @default(0)
  monthlyListeners Int?     @default(0)
  totalStreams     BigInt?  @default(0)
  search_vector    Unsupported("tsvector")?

  tracks Track[]
  albums Album[]

  @@index([name])
}

model Album {
  id          String    @id @default(uuid())
  title       String
  coverUrl    String?
  artistId    String
  releaseDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Search & Ranking Metadata
  popularity_score Float?   @default(0)
  search_vector    Unsupported("tsvector")?

  artist Artist  @relation(fields: [artistId], references: [id])
  tracks Track[]

  @@index([title])
}

model Track {
  id         String    @id @default(uuid())
  title      String
  artistId   String
  albumId    String?
  coverUrl   String?
  audioUrl   String
  duration   Int
  trackNumber Int?     @default(1)
  genre      String?
  lyrics     String?
  description String?
  tags       String[]
  plays      Int       @default(0)
  isFeatured Boolean   @default(false)
  isTrending Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  price      Int       @default(0) // price in cents
  userId     String?   // The uploader
  downloads  Int       @default(0)
  
  // Search & Ranking Metadata
  language        String?   @default("english")
  region          String?   @default("Global")
  track_type      String    @default("original") // original, remix, live, acoustic
  popularity_score Float?   @default(0)
  like_count      Int?      @default(0)
  search_vector   Unsupported("tsvector")?
  
  // New Settings & Release management
  isUnlisted     Boolean   @default(false)
  allowDownloads Boolean   @default(true)
  enableComments Boolean   @default(true)
  releaseStatus  String    @default("PUBLISHED") // PUBLISHED, SCHEDULED, DRAFT
  scheduledAt    DateTime?
  copyrightLabel String?

  // Advanced Metadata
  bpm             Int?
  key             String?
  composers       String?
  producers       String?
  featuredArtists String?

  // Homepage Ranking
  engagement_score Float?  @default(0)
  
  user           User?           @relation(fields: [userId], references: [id])
  artist         Artist          @relation(fields: [artistId], references: [id])
  album          Album?          @relation(fields: [albumId], references: [id])
  likes          Like[]
  playlistTracks PlaylistTrack[]
  userStats      UserTrackStat[]
  history        History[]
  ratings        Rating[]
  purchases      Purchase[]
  analytics      TrackAnalytics[]

  @@index([title])
  @@index([artistId])
  @@index([albumId])
  @@index([deletedAt])
  @@index([genre])
  @@index([plays])
  @@index([createdAt])
  @@index([engagement_score])
  @@index([language])
  @@index([region])
  @@index([track_type])
}

model TrackAnalytics {
  id                String   @id @default(uuid())
  trackId           String
  date              DateTime @default(now())
  total_listen_time Int      @default(0) // time in seconds
  play_count        Int      @default(0)

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, date])
  @@index([date])
}

model Playlist {
  id          String   @id @default(uuid())
  name        String
  description String?
  coverUrl    String?
  userId      String
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Search & Ranking Metadata
  follower_count   Int?     @default(0)
  popularity_score Float?   @default(0)
  search_vector    Unsupported("tsvector")?

  user   User            @relation(fields: [userId], references: [id])
  tracks PlaylistTrack[]

  @@index([name])
  @@index([userId])
}

model PlaylistTrack {
  id         String   @id @default(uuid())
  playlistId String
  trackId    String
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  trackId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  trackId   String
  value     Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

model UserTrackStat {
  id           String   @id @default(uuid())
  userId       String
  trackId      String
  playCount    Int      @default(0)
  lastPlayedAt DateTime @default(now())
  skipCount    Int      @default(0)
  totalListenDuration Int @default(0)
  completionRateAvg Float? @default(0)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model History {
  id        String   @id @default(uuid())
  userId    String
  trackId   String
  playedAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([trackId])
}
