generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String           @id @default(uuid())
  email         String           @unique
  name          String?
  password      String?
  role          Role             @default(LISTENER)
  provider      String           @default("LOCAL")
  googleId      String?          @unique
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  age           Int?
  avatarUrl     String?
  country       String?
  username      String?          @unique
  isVerified    Boolean          @default(false)
  history       History[]
  likes         Like[]
  playlists     Playlist[]
  purchases     Purchase[]
  ratings       Rating[]
  refreshTokens RefreshToken[]
  subscription  Subscription?
  tracks        Track[]
  transactions  Transaction[]
  preferences   UserPreferences?
  stats         UserTrackStat[]
  dailyStats    UserDailyStat[]
  notifications Notification[]
}

model Subscription {
  id          String    @id @default(uuid())
  userId      String    @unique
  status      String
  plan        String    @default("PREMIUM")
  referenceId String?   @unique
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Int
  status      String
  referenceId String   @unique
  type        String
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model Purchase {
  id          String   @id @default(uuid())
  userId      String
  trackId     String
  price       Int      @default(0)
  status      String   @default("COMPLETED")
  referenceId String   @unique
  createdAt   DateTime @default(now())
  track       Track    @relation(fields: [trackId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

model UserPreferences {
  id                  String   @id @default(uuid())
  userId              String   @unique
  onboardingCompleted Boolean  @default(false)
  preferredGenres     String[] @default([])
  audioQuality        String   @default("high")
  crossfade           Boolean  @default(false)
  autoplay            Boolean  @default(true)
  normalizeVolume     Boolean  @default(true)
  explicitFilter      Boolean  @default(false)
  theme               String   @default("dark")
  accentColor         String   @default("green")
  globalPlayerStyle   String   @default("glassmorphism")
  sidebarStyle        String   @default("normal")
  fullviewReactiveBg  Boolean  @default(true)
  trackPageReactiveBg Boolean  @default(true)
  compactMode         Boolean  @default(false)
  emailNotifications  Boolean  @default(true)
  newReleaseAlerts    Boolean  @default(true)
  playlistUpdates     Boolean  @default(true)
  privateSession      Boolean  @default(false)
  listeningActivity   Boolean  @default(true)
  surroundingSpeed    Int      @default(3)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Artist {
  id               String                   @id @default(uuid())
  name             String                   @unique
  bio              String?
  imageUrl         String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  follower_count   Int?                     @default(0)
  popularity_score Float?                   @default(0)
  verified         Boolean?                 @default(false)
  birthDate        DateTime?
  coverUrl         String?
  monthlyListeners Int?                     @default(0)
  role             String?
  search_vector    Unsupported("tsvector")?
  totalStreams     BigInt?                  @default(0)
  aura_color       String?
  aura_vibe        String?
  albums           Album[]
  tracks           Track[]

  @@index([name])
}

model Album {
  id               String                   @id @default(uuid())
  title            String
  coverUrl         String?
  artistId         String
  releaseDate      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  popularity_score Float?                   @default(0)
  search_vector    Unsupported("tsvector")?
  aura_color       String?
  aura_vibe        String?
  palette          Json?   // Stores [{r,g,b},{r,g,b},{r,g,b},{r,g,b}] extracted from coverUrl
  artist           Artist                   @relation(fields: [artistId], references: [id])
  tracks           Track[]

  @@index([title])
}

model Track {
  id               String                   @id @default(uuid())
  title            String
  artistId         String
  albumId          String?
  coverUrl         String?
  audioUrl         String
  duration         Int
  genre            String?
  lyrics           String?
  description      String?
  tags             String[]
  isFeatured       Boolean                  @default(false)
  isTrending       Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  deletedAt        DateTime?
  price            Int                      @default(0)
  allowDownloads   Boolean                  @default(true)
  bpm              Int?
  composers        String?
  copyrightLabel   String?
  downloads        Int                      @default(0)
  enableComments   Boolean                  @default(true)
  featuredArtists  String?
  isUnlisted       Boolean                  @default(false)
  key              String?
  language         String?                  @default("english")
  like_count       Int?                     @default(0)
  popularity_score Float?                   @default(0)
  producers        String?
  releaseStatus    String                   @default("PUBLISHED")
  scheduledAt      DateTime?
  userId           String?
  engagement_score Float?                   @default(0)
  region           String?                  @default("Global")
  search_vector    Unsupported("tsvector")?
  streams          Int                      @default(0)
  trackNumber      Int?                     @default(1)
  track_type       String                   @default("original")
  aura_color       String?
  aura_vibe        String?
  lyrics_meaning   String?
  synced_lyrics    Json?
  raw_lrc          String?
  analysisData     Json?
  palette          Json?   // Stores [{r,g,b},{r,g,b},{r,g,b},{r,g,b}] extracted from coverUrl
  history          History[]
  likes            Like[]
  playlistTracks   PlaylistTrack[]
  purchases        Purchase[]
  ratings          Rating[]
  album            Album?                   @relation(fields: [albumId], references: [id])
  artist           Artist                   @relation(fields: [artistId], references: [id])
  user             User?                    @relation(fields: [userId], references: [id])
  analytics        TrackAnalytics[]
  userStats        UserTrackStat[]

  @@index([title])
  @@index([artistId])
  @@index([albumId])
  @@index([deletedAt])
  @@index([genre])
  @@index([streams])
  @@index([createdAt])
  @@index([engagement_score])
  @@index([language])
  @@index([region])
  @@index([track_type])
}

model TrackAnalytics {
  id                String   @id @default(uuid())
  trackId           String
  date              DateTime @default(now())
  total_listen_time Int      @default(0)
  stream_count      Int      @default(0)
  track             Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, date])
  @@index([date])
}

model Playlist {
  id               String                   @id @default(uuid())
  name             String
  description      String?
  coverUrl         String?
  userId           String
  isPublic         Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  follower_count   Int?                     @default(0)
  popularity_score Float?                   @default(0)
  search_vector    Unsupported("tsvector")?
  user             User                     @relation(fields: [userId], references: [id])
  tracks           PlaylistTrack[]

  @@index([name])
  @@index([userId])
}

model PlaylistTrack {
  id         String   @id @default(uuid())
  playlistId String
  trackId    String
  addedAt    DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  trackId   String
  createdAt DateTime @default(now())
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  trackId   String
  value     Int
  createdAt DateTime @default(now())
  comment   String?
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

model UserTrackStat {
  id                  String   @id @default(uuid())
  userId              String
  trackId             String
  completionRateAvg   Float?   @default(0)
  skipCount           Int      @default(0)
  totalListenDuration Int      @default(0)
  lastStreamedAt      DateTime @default(now())
  streamCount         Int      @default(0)
  track               Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model History {
  id       String   @id @default(uuid())
  userId   String
  trackId  String
  playedAt DateTime @default(now())
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([trackId])
  @@index([playedAt])
}

model UserDailyStat {
  id              String   @id @default(uuid())
  userId          String
  date            DateTime @default(now())
  minutesListened Int      @default(0)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

enum Role {
  ADMIN
  LISTENER
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // e.g., 'upload_success', 'upload_failed', 'content_denied', 'system_info'
  title     String
  message   String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}
